{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "cd frontend && npm ci && npm run build && node ../scripts/stage-vercel-assets.mjs",
  "outputDirectory": "frontend/dist",
  "functions": {
    "app.py": {
      "includeFiles": "{backend/**,outputs/chennai_best_v2.joblib,outputs/chennai_iteration1_metrics.json,data/processed/chennai_training_table_v2.csv}",
      "excludeFiles": "{tests/**,ml/**,frontend/node_modules/**,frontend/screenshots/**,data/raw/**,outputs/baseline/**,outputs/chennai_susceptibility_v2.geojson}"
    }
  }
}
